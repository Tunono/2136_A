// Verilog Self-Checking Test Bench (with test vectors) for design :    mod60Counter
// 
// Simulation tool : 3rd Party
// 

`timescale 1 ps/ 1 ps
module mod60Counter_vlg_sample_tst(
	clk,
	RESET,
	sampler_tx
);
input  clk;
input  RESET;
output sampler_tx;

reg sample;
time current_time;
always @(clk or RESET)
                                                                                
begin                                                 
 if ($realtime > 0)                                   
 begin                                                
	if ($realtime == 0 || $realtime != current_time)  
	begin									          
		if (sample === 1'bx)                          
			sample = 0;                               
		else                                          
			sample = ~sample;                         
	end										          
	current_time = $realtime;					      
 end                                                  
end                                                   

assign sampler_tx = sample;
endmodule

module mod60Counter_vlg_check_tst (
	BQ0,
	BQ1,
	BQ2,
	BQ3,
	Q0,
	Q1,
	Q2,
	RO,
	sampler_rx
);
input  BQ0;
input  BQ1;
input  BQ2;
input  BQ3;
input  Q0;
input  Q1;
input  Q2;
input  RO;
input sampler_rx;

reg  BQ0_expected;
reg  BQ1_expected;
reg  BQ2_expected;
reg  BQ3_expected;
reg  Q0_expected;
reg  Q1_expected;
reg  Q2_expected;
reg  RO_expected;

reg  BQ0_prev;
reg  BQ1_prev;
reg  BQ2_prev;
reg  BQ3_prev;
reg  Q0_prev;
reg  Q1_prev;
reg  Q2_prev;
reg  RO_prev;

reg  BQ0_expected_prev;
reg  BQ1_expected_prev;
reg  BQ2_expected_prev;
reg  BQ3_expected_prev;
reg  Q0_expected_prev;
reg  Q1_expected_prev;
reg  Q2_expected_prev;
reg  RO_expected_prev;

reg  last_BQ0_exp;
reg  last_BQ1_exp;
reg  last_BQ2_exp;
reg  last_BQ3_exp;
reg  last_Q0_exp;
reg  last_Q1_exp;
reg  last_Q2_exp;
reg  last_RO_exp;

reg trigger;

integer i;
integer nummismatches;

reg [1:8] on_first_change ;


initial
begin
trigger = 0;
i = 0;
nummismatches = 0;
on_first_change = 8'b1;
end

// update real /o prevs

always @(trigger)
begin
	BQ0_prev = BQ0;
	BQ1_prev = BQ1;
	BQ2_prev = BQ2;
	BQ3_prev = BQ3;
	Q0_prev = Q0;
	Q1_prev = Q1;
	Q2_prev = Q2;
	RO_prev = RO;
end

// update expected /o prevs

always @(trigger)
begin
	BQ0_expected_prev = BQ0_expected;
	BQ1_expected_prev = BQ1_expected;
	BQ2_expected_prev = BQ2_expected;
	BQ3_expected_prev = BQ3_expected;
	Q0_expected_prev = Q0_expected;
	Q1_expected_prev = Q1_expected;
	Q2_expected_prev = Q2_expected;
	RO_expected_prev = RO_expected;
end



// expected BQ3
initial
begin
	BQ3_expected = 1'bX;
end 

// expected BQ2
initial
begin
	BQ2_expected = 1'bX;
end 

// expected BQ1
initial
begin
	BQ1_expected = 1'bX;
end 

// expected BQ0
initial
begin
	BQ0_expected = 1'bX;
end 

// expected Q2
initial
begin
	Q2_expected = 1'bX;
end 

// expected Q1
initial
begin
	Q1_expected = 1'bX;
end 

// expected Q0
initial
begin
	Q0_expected = 1'bX;
end 

// expected RO
initial
begin
	RO_expected = 1'bX;
end 
// generate trigger
always @(BQ0_expected or BQ0 or BQ1_expected or BQ1 or BQ2_expected or BQ2 or BQ3_expected or BQ3 or Q0_expected or Q0 or Q1_expected or Q1 or Q2_expected or Q2 or RO_expected or RO)
begin
	trigger <= ~trigger;
end

always @(posedge sampler_rx or negedge sampler_rx)
begin
`ifdef debug_tbench
	$display("Scanning pattern %d @time = %t",i,$realtime );
	i = i + 1;
	$display("| expected BQ0 = %b | expected BQ1 = %b | expected BQ2 = %b | expected BQ3 = %b | expected Q0 = %b | expected Q1 = %b | expected Q2 = %b | expected RO = %b | ",BQ0_expected_prev,BQ1_expected_prev,BQ2_expected_prev,BQ3_expected_prev,Q0_expected_prev,Q1_expected_prev,Q2_expected_prev,RO_expected_prev);
	$display("| real BQ0 = %b | real BQ1 = %b | real BQ2 = %b | real BQ3 = %b | real Q0 = %b | real Q1 = %b | real Q2 = %b | real RO = %b | ",BQ0_prev,BQ1_prev,BQ2_prev,BQ3_prev,Q0_prev,Q1_prev,Q2_prev,RO_prev);
`endif
	if (
		( BQ0_expected_prev !== 1'bx ) && ( BQ0_prev !== BQ0_expected_prev )
		&& ((BQ0_expected_prev !== last_BQ0_exp) ||
			on_first_change[1])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port BQ0 :: @time = %t",  $realtime);
		$display ("     Expected value = %b", BQ0_expected_prev);
		$display ("     Real value = %b", BQ0_prev);
		nummismatches = nummismatches + 1;
		on_first_change[1] = 1'b0;
		last_BQ0_exp = BQ0_expected_prev;
	end
	if (
		( BQ1_expected_prev !== 1'bx ) && ( BQ1_prev !== BQ1_expected_prev )
		&& ((BQ1_expected_prev !== last_BQ1_exp) ||
			on_first_change[2])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port BQ1 :: @time = %t",  $realtime);
		$display ("     Expected value = %b", BQ1_expected_prev);
		$display ("     Real value = %b", BQ1_prev);
		nummismatches = nummismatches + 1;
		on_first_change[2] = 1'b0;
		last_BQ1_exp = BQ1_expected_prev;
	end
	if (
		( BQ2_expected_prev !== 1'bx ) && ( BQ2_prev !== BQ2_expected_prev )
		&& ((BQ2_expected_prev !== last_BQ2_exp) ||
			on_first_change[3])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port BQ2 :: @time = %t",  $realtime);
		$display ("     Expected value = %b", BQ2_expected_prev);
		$display ("     Real value = %b", BQ2_prev);
		nummismatches = nummismatches + 1;
		on_first_change[3] = 1'b0;
		last_BQ2_exp = BQ2_expected_prev;
	end
	if (
		( BQ3_expected_prev !== 1'bx ) && ( BQ3_prev !== BQ3_expected_prev )
		&& ((BQ3_expected_prev !== last_BQ3_exp) ||
			on_first_change[4])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port BQ3 :: @time = %t",  $realtime);
		$display ("     Expected value = %b", BQ3_expected_prev);
		$display ("     Real value = %b", BQ3_prev);
		nummismatches = nummismatches + 1;
		on_first_change[4] = 1'b0;
		last_BQ3_exp = BQ3_expected_prev;
	end
	if (
		( Q0_expected_prev !== 1'bx ) && ( Q0_prev !== Q0_expected_prev )
		&& ((Q0_expected_prev !== last_Q0_exp) ||
			on_first_change[5])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port Q0 :: @time = %t",  $realtime);
		$display ("     Expected value = %b", Q0_expected_prev);
		$display ("     Real value = %b", Q0_prev);
		nummismatches = nummismatches + 1;
		on_first_change[5] = 1'b0;
		last_Q0_exp = Q0_expected_prev;
	end
	if (
		( Q1_expected_prev !== 1'bx ) && ( Q1_prev !== Q1_expected_prev )
		&& ((Q1_expected_prev !== last_Q1_exp) ||
			on_first_change[6])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port Q1 :: @time = %t",  $realtime);
		$display ("     Expected value = %b", Q1_expected_prev);
		$display ("     Real value = %b", Q1_prev);
		nummismatches = nummismatches + 1;
		on_first_change[6] = 1'b0;
		last_Q1_exp = Q1_expected_prev;
	end
	if (
		( Q2_expected_prev !== 1'bx ) && ( Q2_prev !== Q2_expected_prev )
		&& ((Q2_expected_prev !== last_Q2_exp) ||
			on_first_change[7])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port Q2 :: @time = %t",  $realtime);
		$display ("     Expected value = %b", Q2_expected_prev);
		$display ("     Real value = %b", Q2_prev);
		nummismatches = nummismatches + 1;
		on_first_change[7] = 1'b0;
		last_Q2_exp = Q2_expected_prev;
	end
	if (
		( RO_expected_prev !== 1'bx ) && ( RO_prev !== RO_expected_prev )
		&& ((RO_expected_prev !== last_RO_exp) ||
			on_first_change[8])
	)
	begin
		$display ("ERROR! Vector Mismatch for output port RO :: @time = %t",  $realtime);
		$display ("     Expected value = %b", RO_expected_prev);
		$display ("     Real value = %b", RO_prev);
		nummismatches = nummismatches + 1;
		on_first_change[8] = 1'b0;
		last_RO_exp = RO_expected_prev;
	end

	trigger <= ~trigger;
end
initial 

begin 
$timeformat(-12,3," ps",6);
#800000;
if (nummismatches > 0)
	$display ("%d mismatched vectors : Simulation failed !",nummismatches);
else
	$display ("Simulation passed !");
$finish;
end 
endmodule

module mod60Counter_vlg_vec_tst();
// constants                                           
// general purpose registers
reg clk;
reg RESET;
// wires                                               
wire BQ0;
wire BQ1;
wire BQ2;
wire BQ3;
wire Q0;
wire Q1;
wire Q2;
wire RO;

wire sampler;                             

// assign statements (if any)                          
mod60Counter i1 (
// port map - connection between master ports and signals/registers   
	.BQ0(BQ0),
	.BQ1(BQ1),
	.BQ2(BQ2),
	.BQ3(BQ3),
	.clk(clk),
	.Q0(Q0),
	.Q1(Q1),
	.Q2(Q2),
	.RESET(RESET),
	.RO(RO)
);

// clk
always
begin
	clk = 1'b0;
	clk = #5000 1'b1;
	#5000;
end 

// RESET
initial
begin
	RESET = 1'b0;
	RESET = #60000 1'b1;
end 

mod60Counter_vlg_sample_tst tb_sample (
	.clk(clk),
	.RESET(RESET),
	.sampler_tx(sampler)
);

mod60Counter_vlg_check_tst tb_out(
	.BQ0(BQ0),
	.BQ1(BQ1),
	.BQ2(BQ2),
	.BQ3(BQ3),
	.Q0(Q0),
	.Q1(Q1),
	.Q2(Q2),
	.RO(RO),
	.sampler_rx(sampler)
);
endmodule

