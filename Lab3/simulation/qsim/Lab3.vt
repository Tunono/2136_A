module Lab3_top_vlg_vec_tst();
// constants                                           
// general purpose registers
reg clk;
reg CLRN;
// wires                                               
wire A0;
wire A1;
wire A2;
wire A3;
wire B0;
wire B1;
wire B2;
wire B3;
wire C0;
wire C1;
wire C2;
wire C3;
wire Cy;
wire N;
wire S0;
wire S1;
wire S2;
wire S3;
wire V;
wire Z;

wire sampler;                             

// assign statements (if any)                          
Lab3_top i1 (
// port map - connection between master ports and signals/registers   
	.A0(A0),
	.A1(A1),
	.A2(A2),
	.A3(A3),
	.B0(B0),
	.B1(B1),
	.B2(B2),
	.B3(B3),
	.C0(C0),
	.C1(C1),
	.C2(C2),
	.C3(C3),
	.clk(clk),
	.CLRN(CLRN),
	.Cy(Cy),
	.N(N),
	.S0(S0),
	.S1(S1),
	.S2(S2),
	.S3(S3),
	.V(V),
	.Z(Z)
);

// clk
always
begin
	clk = 1'b0;
	clk = #2500 1'b1;
	#2500;
end 

Lab3_top_vlg_sample_tst tb_sample (
	.clk(clk),
	.CLRN(CLRN),
	.sampler_tx(sampler)
);

